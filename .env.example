# Enigma API - Environment Configuration Example
# Copy this file to .env and configure strong, secret values for deployment.
# Never commit the actual .env file or production secrets to source control.

# Required in production: A strong, cryptographically secure secret key for signing JWTs
ENIGMA_JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars_long

# JWT Algorithm (default: HS256)
ENIGMA_JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 60)
ENIGMA_JWT_EXPIRE_MINUTES=60

# Optional JWT Issuer and Audience for token validation
ENIGMA_JWT_ISSUER=enigma-api
ENIGMA_JWT_AUDIENCE=enigma-clients

# Path to persistent SQLite databases (relative to project root or absolute)
ENIGMA_AUTH_DB=data/auth.sqlite3
ENIGMA_AUDIT_DB=data/audit.sqlite3
ENIGMA_APPROVALS_DB=data/approvals.sqlite3
